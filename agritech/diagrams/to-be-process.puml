@startuml
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 14
skinparam ArrowColor #42637E
skinparam classBackgroundColor #F4F8FB
skinparam classBorderColor #42637E
skinparam actorBorderColor #42637E
skinparam usecaseBackgroundColor #F4F8FB
skinparam usecaseBorderColor #42637E
skinparam noteBackgroundColor #FFF9E8
skinparam noteBorderColor #A79151
title TO-BE: регистрация и независимый обмен
start
partition "Регистрация сбора" {
   :Оператор: подготовить исходный ключ\nи реквизиты документа;
   if (Сорт, участок и сезон согласованы?) then (да)
     :Production: проверить права,\nдату, массу и уникальность;
   else (нет)
     :Отказать без создания партии;
     :Ответственный за справочники / агроном: согласовать ссылку — UC-01;
     stop
   endif
   :Production: сохранить партию, результат запроса\nи сообщение к отправке;
 }
fork
   :Оператор: получить 201 и batchId;
fork again
   partition "Независимая доставка и приёмка" {
     :Издатель: отправить событие;\nповторить при временном сбое;
     :WMS: сохранить номер сообщения\nи ожидаемую приёмку;
     :Кладовщик: найти batchId,\nизмерить массу и подтвердить приёмку;
     :WMS: сохранить приёмку и сообщение;
     :Издатель WMS: передать событие приёмки;
     :Production / BI: сохранить полученные сведения\nбез повторного создания записи;
     :Отчёт: показать полноту и разницу масс;
   }
end fork
stop
@enduml
