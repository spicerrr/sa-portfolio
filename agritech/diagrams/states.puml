@startuml
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 14
skinparam ArrowColor #42637E
skinparam classBackgroundColor #F4F8FB
skinparam classBorderColor #42637E
skinparam actorBorderColor #42637E
skinparam usecaseBackgroundColor #F4F8FB
skinparam usecaseBorderColor #42637E
skinparam noteBackgroundColor #FFF9E8
skinparam noteBorderColor #A79151
title Локальная проекция приёмки
state "Подтверждение отсутствует" as NO_RECEIPT
state "Подтверждение сохранено" as HAS_RECEIPT
[*] --> NO_RECEIPT : зарегистрирован сбор
NO_RECEIPT --> HAS_RECEIPT : валидное событие приёмки\nсохранение складских сведений\nи номера сообщения
HAS_RECEIPT --> HAS_RECEIPT : повтор события\nбез нового эффекта
note right of NO_RECEIPT
Отсутствие проекции не доказывает,
что груз физически не принят.
end note
note right of HAS_RECEIPT
Одна полная приёмка.
Исправление требует отдельного процесса.
end note
@enduml
